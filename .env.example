# =========================================================================
# LMS-test — Independent Testing Environment Configuration Template
# =========================================================================
# This file serves as the configuration template for the LMS-test independent clone.
# Copy this file to .env and adjust values for your local development or testing server.
#
# IMPORTANT:
# - Never configure production API keys or live production database credentials here.
# - Defaults are preconfigured for safe, isolated local testing and mock proxying.
# =========================================================================

# -------------------------------------------------------------------------
# 1. CORE APPLICATION & ROUTING CONFIGURATION
# -------------------------------------------------------------------------
# Base URL for the testing frontend application.
# For local development: http://localhost:3000 (or http://localhost:5173)
# For testing subdomain: https://test.broadbeachonline.com
VITE_APP_URL=http://localhost:3000
VITE_SITE_URL=http://localhost:3000

# Base routing path for React Router.
# Use "/" when running locally or on custom domain.
# If deploying to GitHub Pages without custom domain, set to repository path (e.g., /LMS-test)
VITE_BASENAME=/

# Optional custom domain for postbuild CNAME generation.
# Leave empty unless deploying to GitHub Pages with a dedicated test domain.
VITE_CUSTOM_DOMAIN=
CUSTOM_DOMAIN=

# -------------------------------------------------------------------------
# 2. BACKEND API & ASSETS CONFIGURATION (SAFE TESTING DEFAULTS)
# -------------------------------------------------------------------------
# API endpoint for LMS authentication, courses, assessments, and tickets.
# Default "/api" safely directs calls to Vite's local proxy or test mock server,
# ensuring test runs NEVER mutate or corrupt the live production database.
VITE_API_URL=/api
VITE_API_URL_ASSETS=/uploads

# -------------------------------------------------------------------------
# 3. MAINTENANCE MODE TOGGLE
# -------------------------------------------------------------------------
# In LMS-test, maintenance mode defaults to false so all 340+ courses,
# assessments, learning player, and certificate verification are immediately testable.
VITE_MAINTENANCE_MODE=false

# -------------------------------------------------------------------------
# 4. CONFIGURABLE ADMIN ACCESS LAYER
# -------------------------------------------------------------------------
# Admin login path and dashboard base.
# To generate a new random admin path: node scripts/rotate-admin-path.cjs
VITE_ADMIN_LOGIN_PATH=/secure-console/test-admin-secret-access-token
ADMIN_LOGIN_PATH=/secure-console/test-admin-secret-access-token
VITE_ADMIN_BASE_PATH=/admin
ADMIN_BASE_PATH=/admin
